{
    "name": "osmianski/fast-refresh-database",
    "description": "Skip migrating the test database when nothing about it has changed 🚀",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Sam Carré",
            "email": "29132017+Sammyjo20@users.noreply.github.com"
        },
        {
            "name": "Vlad Osmianski",
            "email": "vlaosm@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "symfony/finder": "^6.0 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.13",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0"
    },
    "conflict": {
        "plannr/laravel-fast-refresh-database": "*"
    },
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "Osmianski\\FastRefreshDatabase\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Osmianski\\FastRefreshDatabase\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Osmianski\\FastRefreshDatabase\\FastRefreshDatabaseServiceProvider"
            ]
        }
    },
    "scripts": {
        "fix-code": [
            "./vendor/bin/php-cs-fixer fix"
        ]
    }
}
